        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 20 11 L 20 13"
                    android:valueTo="M 20 3 L 20 12"
                    android:duration="250"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 20 3 L 20 12"
                    android:valueTo="M 20 11 L 20 13"
                    android:duration="250"
                    android:startOffset="250"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>