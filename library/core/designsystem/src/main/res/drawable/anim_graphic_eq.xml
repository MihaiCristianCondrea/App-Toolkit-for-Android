<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="path_1"
                android:pathData="M 4 11 L 4 13"
                android:strokeColor="#ffffff"
                android:strokeWidth="2"
                android:strokeLineCap="round" />
            <path
                android:name="path_2"
                android:pathData="M 8 7 L 8 17"
                android:strokeColor="#ffffff"
                android:strokeWidth="2"
                android:strokeLineCap="round" />
            <path
                android:name="path_3"
                android:pathData="M 12 3 L 12 21"
                android:strokeColor="#ffffff"
                android:strokeWidth="2"
                android:strokeLineCap="round" />
            <path
                android:name="path_4"
                android:pathData="M 16 7 L 16 17"
                android:strokeColor="#ffffff"
                android:strokeWidth="2"
                android:strokeLineCap="round" />
            <path
                android:name="path_5"
                android:pathData="M 20 11 L 20 13"
                android:strokeColor="#ffffff"
                android:strokeWidth="2"
                android:strokeLineCap="round" />
        </vector>
    </aapt:attr>

    <target android:name="path_3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 12 3 L 12 21"
                    android:valueTo="M 12 8 L 12 18"
                    android:duration="250"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 12 8 L 12 18"
                    android:valueTo="M 12 3 L 12 21"
                    android:duration="250"
                    android:startOffset="250"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="path_2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 8 7 L 8 17"
                    android:valueTo="M 8 11 L 8 16"
                    android:duration="200"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 8 7 L 8 19"
                    android:valueTo="M 8 7 L 8 17"
                    android:duration="150"
                    android:startOffset="350"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 8 11 L 8 16"
                    android:valueTo="M 8 7 L 8 19"
                    android:duration="150"
                    android:startOffset="200"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="path_1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 4 11 L 4 13"
                    android:valueTo="M 4 8 L 4 14"
                    android:duration="250"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 4 8 L 4 14"
                    android:valueTo="M 4 11 L 4 13"
                    android:duration="250"
                    android:startOffset="250"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="path_4">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 16 7 L 16 17"
                    android:valueTo="M 16 5 L 16 14"
                    android:duration="100"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 16 12 L 16 21"
                    android:valueTo="M 16 7 L 16 17"
                    android:duration="200"
                    android:startOffset="300"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="pathData"
                    android:valueFrom="M 16 5 L 16 14"
                    android:valueTo="M 16 12 L 16 21"
                    android:duration="200"
                    android:startOffset="100"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

