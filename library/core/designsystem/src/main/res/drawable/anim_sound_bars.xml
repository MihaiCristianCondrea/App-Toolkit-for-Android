<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <!-- Left Bar -->
            <path
                android:name="bar_left"
                android:pathData="M 6,19 L 6,7"
                android:strokeColor="?android:attr/colorControlNormal"
                android:strokeWidth="3"
                android:strokeLineCap="round" />

            <!-- Center Bar -->
            <path
                android:name="bar_center"
                android:pathData="M 12,19 L 12,4"
                android:strokeColor="?android:attr/colorControlNormal"
                android:strokeWidth="3"
                android:strokeLineCap="round" />

            <!-- Right Bar -->
            <path
                android:name="bar_right"
                android:pathData="M 18,19 L 18,10"
                android:strokeColor="?android:attr/colorControlNormal"
                android:strokeWidth="3"
                android:strokeLineCap="round" />
        </vector>
    </aapt:attr>

    <!-- Left Bar Animation -->
    <target android:name="bar_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="380"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="M 6,19 L 6,7"
                android:valueTo="M 6,19 L 6,19"
                android:valueType="pathType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:pathData="M 0,0 C 0.4,0 0.2,1 1,1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Center Bar Animation -->
    <target android:name="bar_center">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="270"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="M 12,19 L 12,4"
                android:valueTo="M 12,19 L 12,19"
                android:valueType="pathType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:pathData="M 0,0 C 0.4,0 0.2,1 1,1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Right Bar Animation -->
    <target android:name="bar_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="330"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="M 18,19 L 18,10"
                android:valueTo="M 18,19 L 18,19"
                android:valueType="pathType">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:pathData="M 0,0 C 0.4,0 0.2,1 1,1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>