    <string name="access_network_state">ネットワーク状態へのアクセス [ACCESS_NETWORK_STATE]</string>
    <string name="ad_id">広告ID [AD_ID]</string>
    <string name="billing">請求 [BILLING]</string>
    <string name="check_license">ライセンスの確認 [CHECK_LICENSE]</string>
    <string name="foreground_service">フォアグラウンドサービス [FOREGROUND_SERVICE]</string>
