    <string name="runtime">執行時</string>
    <string name="summary_preference_permissions_access_network_state">允許應用程式檢查網路連線並擷取 Wi-Fi 相關資訊，包括啟用狀態和已連線的 Wi-Fi 裝置名稱。</string>
    <string name="summary_preference_permissions_ad_id">允許應用程式擷取並使用與使用者裝置相關聯的廣告識別碼，提供個人化廣告、衡量廣告成效，以及在 Android 13 或更新版本的裝置上顯示廣告。</string>
    <string name="summary_preference_permissions_billing">允許應用程式使用 Google Play 計費程式庫處理應用程式內購買和捐贈</string>
    <string name="summary_preference_permissions_check_license">允許應用程式驗證其是否符合授權協議，並強制執行授權條款以保護智慧財產權。</string>
    <string name="summary_preference_permissions_foreground_service">允許應用程式建立並使用在前景執行的服務，賦予它們優先於其他背景處理程序的權限，並改善效能和可靠性。</string>
    <string name="summary_preference_permissions_internet">允許應用程式建立網際網路連線以傳送錯誤報告或檢查更新。</string>
    <string name="summary_preference_permissions_post_notifications">允許應用程式在搭載 Android 13 或更新版本的裝置上顯示通知。</string>
    <string name="summary_preference_permissions_wake_lock">允許應用程式在關鍵作業期間防止裝置進入休眠狀態 (例如螢幕變暗或處理器休眠)，以確保作業不中斷並順利完成。此功能會謹慎使用以節省電池電量。</string>
    <string name="wake_lock">保持裝置喚醒 [WAKE_LOCK]</string>
</resources>
