<resources>
    <string name="holiday_greeting_christmas_title">ब्र्र्र… क्रिसमस आ गया!</string>
    <string name="holiday_greeting_christmas_message">स्नोमैन आ गए हैं, और एक नया बर्फ़ीला लुक आपका इंतज़ार कर रहा है। ऐप में थोड़ा सर्दियों का जादू लाने के लिए तैयार हैं?</string>
    <string name="holiday_greeting_christmas_accept">बर्फ़ गिरने दो!</string>
    <string name="holiday_greeting_halloween_title">कद्दू जाग गए हैं!</string>
    <string name="holiday_greeting_halloween_message">चाँद चमक रहा है, कद्दू मुस्कुरा रहे हैं, और एक नया डरावना लुक आपका इंतज़ार कर रहा है। हैलोवीन मेकओवर के लिए तैयार हैं?</string>
    <string name="holiday_greeting_halloween_accept">डरावना हो जाए!</string>
    <string name="holiday_greeting_keep_theme">मेरी थीम रखें</string>
    <string name="dark_theme">डार्क थीम</string>
    <string name="weather_effect">मौसम इफ़ेक्ट</string>
    <string name="weather_effect_automatic">अपने-आप</string>
    <string name="weather_effect_snow">बर्फ़</string>
    <string name="weather_effect_off">बंद</string>
    <string name="weather_effect_rain">बारिश</string>
    <string name="weather_effect_info">अपने-आप पर, क्रिसमस पैलेट इस्तेमाल होने तक बर्फ़ गिरती है। बर्फ़ और बारिश किसी भी पैलेट के साथ होती हैं।</string>
</resources>
