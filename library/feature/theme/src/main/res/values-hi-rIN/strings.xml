<resources>
    <string name="holiday_greeting_christmas_title">त्योहारों की शुभकामनाएँ!</string>
    <string name="holiday_greeting_christmas_message">क्रिसमस थीम आ गई है, पूरे ऐप में बर्फ़ गिर रही है। क्या आप इसे छुट्टियाँ खत्म होने तक इस्तेमाल करना चाहेंगे?</string>
    <string name="holiday_greeting_halloween_title">हैप्पी हैलोवीन!</string>
    <string name="holiday_greeting_halloween_message">डरावना मौसम आ गया है। क्या आप इसके रहते हैलोवीन थीम इस्तेमाल करना चाहेंगे?</string>
    <string name="holiday_greeting_use_theme">छुट्टियों के दौरान त्योहार थीम इस्तेमाल करें</string>
    <string name="dark_theme">डार्क थीम</string>
    <string name="weather_effect">मौसम इफ़ेक्ट</string>
    <string name="weather_effect_automatic">अपने-आप</string>
    <string name="weather_effect_snow">बर्फ़</string>
    <string name="weather_effect_off">बंद</string>
    <string name="weather_effect_rain">बारिश</string>
    <string name="weather_effect_info">अपने-आप पर, क्रिसमस पैलेट इस्तेमाल होने तक बर्फ़ गिरती है। बर्फ़ और बारिश किसी भी पैलेट के साथ होती हैं।</string>
</resources>
