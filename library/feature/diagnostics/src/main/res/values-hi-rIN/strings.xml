    <string name="advanced_privacy_settings">उन्नत गोपनीयता सेटिंग</string>
    <string name="consent_ad_personalization_description">Google सेवाओं और ऐप्लिकेशन पर आपकी गतिविधि और प्राथमिकताओं के आधार पर निजीकृत विज्ञापन सक्षम करें।</string>
    <string name="consent_ad_personalization_title">निजीकृत विज्ञापन</string>
    <string name="consent_ad_storage_description">विज्ञापन प्रदर्शन को मापने और प्रासंगिक विज्ञापन दिखाने के लिए डेटा (जैसे डिवाइस पहचानकर्ता या कुकी) स्टोर करना सक्षम करें।</string>
    <string name="consent_ad_storage_title">विज्ञापन डेटा स्टोर करें</string>
    <string name="consent_ad_user_data_description">कन्वर्ज़न और कैंपेन ऑप्टिमाइज़ेशन जैसी विज्ञापन-संबंधी सुविधाओं का समर्थन करने के लिए Google को उपयोग और डिवाइस डेटा भेजने की अनुमति दें।</string>
    <string name="consent_ad_user_data_title">विज्ञापनों के लिए डेटा भेजें</string>
