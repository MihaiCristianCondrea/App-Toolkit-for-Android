    <target android:name="toolbox">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="1000"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="translateY"
                    android:repeatCount="infinite"
                    android:valueType="floatType">
                    <propertyValuesHolder android:propertyName="translateY">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="0" />
                        <keyframe android:fraction="0.4" android:value="-2" />
                        <keyframe android:fraction="0.64" android:value="-7" />
                        <keyframe android:fraction="0.72" android:value="-7" />
                        <keyframe android:fraction="0.82" android:value="-4" />
                        <keyframe android:fraction="0.92" android:value="-1" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:duration="1000"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="scaleY"
                    android:repeatCount="infinite"
                    android:valueType="floatType">
                    <propertyValuesHolder android:propertyName="scaleY">
                        <keyframe android:fraction="0" android:value="1" />
                        <keyframe android:fraction="0.3" android:value="1" />
                        <keyframe android:fraction="0.4" android:value="1.01" />
                        <keyframe android:fraction="0.64" android:value="1.02" />
                        <keyframe android:fraction="0.72" android:value="1.02" />
                        <keyframe android:fraction="0.92" android:value="0.98" />
                        <keyframe android:fraction="1" android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>

    <target android:name="wrench">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="1000"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="rotation"
                    android:repeatCount="infinite"
                    android:valueType="floatType">
                    <propertyValuesHolder android:propertyName="rotation">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="0" />
                        <keyframe android:fraction="0.45" android:value="-10" />
                        <keyframe android:fraction="0.6" android:value="6" />
                        <keyframe android:fraction="0.72" android:value="-3" />
                        <keyframe android:fraction="0.84" android:value="0" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>

    <target android:name="screwdriver">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="1000"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="rotation"
                    android:repeatCount="infinite"
                    android:valueType="floatType">
                    <propertyValuesHolder android:propertyName="rotation">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.3" android:value="0" />
                        <keyframe android:fraction="0.45" android:value="10" />
                        <keyframe android:fraction="0.6" android:value="-6" />
                        <keyframe android:fraction="0.72" android:value="3" />
                        <keyframe android:fraction="0.84" android:value="0" />
                        <keyframe android:fraction="1" android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
