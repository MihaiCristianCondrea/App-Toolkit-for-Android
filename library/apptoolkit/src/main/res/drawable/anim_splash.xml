                android:name="toolbox"
                android:pivotX="196.5"
                android:pivotY="287.49"
                android:scaleY="1"
                android:translateY="0">
                <group
                    android:scaleX="0.41824"
                    android:scaleY="0.41824"
                    android:translateX="68.52"
                    android:translateY="31.862">
                    <path android:fillColor="#BF7A00" android:pathData="M167.3,274.1v-43c0-30.4,24.6-55,55-55h167.3c30.4,0,55,24.6,55,55v43h-45.4v-40.6c0-10.5-8.6-19.1-19.1-19.1H231.9c-10.5,0-19.1,8.6-19.1,19.1v40.6H167.3z" />
