                            <path android:fillColor="#EE9B00" android:pathData="M151,16.3h19.1c9.9,0,17.9,8,17.9,17.9v64.5c0,9.9-8,17.9-17.9,17.9H151c-9.9,0-17.9-8-17.9-17.9V34.2C133,24.3,141.1,16.3,151,16.3z" />
