                            <path android:fillColor="#EE9B00" android:pathData="M-95.2,86.1l0,38.2c0,9.9,8,17.9,17.9,17.9s17.9-8,17.9-17.9l0-38.2c0.7-1.9,2.8-2.8,4.6-2.1c0.5,0.2,1,0.5,1.4,0.9c23.4,10.8,33.6,38.4,22.9,61.8c-5.2,11.3-14.7,20.1-26.5,24.4l0,80c0,11.2-9.1,20.3-20.3,20.3c-11.2,0-20.3-9.1-20.3-20.3l0-80c-24.2-8.8-36.7-35.5-27.9-59.7c4.3-11.7,13-21.3,24.4-26.5c1.4-1.4,3.6-1.5,5.1-0.2C-95.7,85.2-95.4,85.6-95.2,86.1z" />
