                    <path android:fillColor="#B36E00" android:pathData="M258.2,366.1h95.6v9.6h-95.6z" />
                    <path android:fillColor="#C67D05" android:pathData="M273.7,375.7h64.5V408c0,9.2-7.5,16.7-16.7,16.7h-31.1c-9.2,0-16.7-7.5-16.7-16.7V375.7z" />
