<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_settings"
        android:shortcutDisabledMessage="@string/settings_disabled_message"
        android:shortcutId="openSettings"
        android:shortcutLongLabel="@string/long_settings_label"
        android:shortcutShortLabel="@string/settings">
        <intent
            android:action="com.d4rk.android.apps.apptoolkit.action.OPEN_SETTINGS"
            android:targetClass="com.mihaicristiancondrea.android.apps.apptoolkit.app.main.ui.MainActivity"
            android:targetPackage="@string/app_package_name" />
    </shortcut>
</shortcuts>
