<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <service
            android:name="com.mihaicristiancondrea.android.apps.apptoolkit.feature.tiles.ui.services.CoinFlipTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_coin"
            android:label="@string/tile_coin_flip_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.mihaicristiancondrea.android.apps.apptoolkit.feature.tiles.ui.services.CounterTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_counter"
            android:label="@string/tile_counter_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.mihaicristiancondrea.android.apps.apptoolkit.feature.tiles.ui.services.DiceRollTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_dice"
            android:label="@string/tile_dice_roll_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.mihaicristiancondrea.android.apps.apptoolkit.feature.tiles.ui.services.CaffeineService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <service
            android:name="com.mihaicristiancondrea.android.apps.apptoolkit.feature.tiles.ui.services.FlashDimmerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_flash_dimmer"
            android:label="@string/tile_flash_dimmer_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
