  "scenes": [
    {
      "id": "motif",
      "start": 0,
      "end": 1.76,
      "title": "Open on the motif",
      "action": "Material Symbols in the six kit shapes land on the opening notes; water and breathe answer together on the fifth note."
    },
    {
      "id": "split",
      "start": 1.76,
      "end": 3.32,
      "title": "Pop. Split. Launch.",
      "action": "The original mark anticipates, overshoots and splits. Its lid exits above frame; the tool-bearing body lands at the bottom."
    },
    {
      "id": "burst",
      "start": 3.32,
      "end": 6.76,
      "title": "The kit in motion",
      "action": "Six real widgets burst from the bottom launcher on detected notes, without a headline."
    },
    {
      "id": "one-place",
      "start": 6.76,
      "end": 10.08,
      "title": "One place.",
      "action": "All six widgets and Material Colors unfold into landscape bento rows under masked type, then fold into measured phone coordinates."
    },
    {
      "id": "quick-tools",
      "start": 10.08,
      "end": 17.14,
      "title": "Quick tools.",
      "action": "The same bento pulls into the Pixel aperture. The headline pushes the device right; sensor values and tool chips answer the notes."
    },
    {
      "id": "measure",
      "start": 17.14,
      "end": 21.98,
      "title": "Measure.",
      "action": "The tab grows a backdrop from its measured control. Live cards relay across the frame with value changes on notes."
    },
    {
      "id": "play",
      "start": 21.98,
      "end": 26.26,
      "title": "Let chance decide.",
      "action": "The outgoing Counter flies across the chapter boundary; the real wheel spins, followed by number, die and coin."
    },
    {
      "id": "close",
      "start": 26.26,
      "end": 29.88,
      "title": "App Toolkit. Your toolkit.",
      "action": "Play carries into the three-destination fan. Mark, masked headline and original badge settle by 28.26; final notes move only background shapes."
    }
  ],
