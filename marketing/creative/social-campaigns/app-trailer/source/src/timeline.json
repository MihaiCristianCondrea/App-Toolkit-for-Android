  "scenes": [
    {
      "id": "motif",
      "start": 0,
      "end": 1.76,
      "title": "Build the kit on the motif",
      "action": "Six kit symbols arrive in a clear 3x2 formation on five notes; Water and Breathe share the last note."
    },
    {
      "id": "split",
      "start": 1.76,
      "end": 3.32,
      "title": "Open the chest",
      "action": "The original lid folds behind the body at their seam and shares its drop; the mirrored inside hides the handle."
    },
    {
      "id": "burst",
      "start": 3.32,
      "end": 6.76,
      "title": "Follow the tools",
      "action": "Four real cards fan through separate lanes. The camera whips from Compass and Flashlight to Level and SOS as live values change."
    },
    {
      "id": "one-place",
      "start": 6.76,
      "end": 10.08,
      "title": "Gather, then push into the bento",
      "action": "Four widgets gather beside One place. After the headline hold, the grid spreads across the frame and the camera pushes closer."
    },
    {
      "id": "quick-tools",
      "start": 10.08,
      "end": 17.14,
      "title": "Lift the tools into use",
      "action": "The bento assembles into the centre-built device. Compass and Level lift from their exact screen rectangles, demonstrate live values, then return as the tool-name belt advances."
    },
    {
      "id": "measure",
      "start": 17.14,
      "end": 21.98,
      "title": "Follow four measurements",
      "action": "The device crosses left. Four measured cards grow into varied hero poses; the counter takes a solo close-up, then the camera follows its return into the device."
    },
    {
      "id": "play",
      "start": 21.98,
      "end": 26.26,
      "title": "Give chance the stage",
      "action": "The wheel grows from the phone and spins. Its result sends the device offstage as the wheel crosses left; chance cards fly into the right side, then all return for the closing fan."
    },
    {
      "id": "close",
      "start": 26.26,
      "end": 29.88,
      "title": "App Toolkit. Your toolkit.",
      "action": "Three labelled destinations hold beside the original badge for 1.5 seconds; the mark anticipates at 29.4, kit gold explodes at 29.54 and the centred mark lands at 29.8."
    }
  ],
